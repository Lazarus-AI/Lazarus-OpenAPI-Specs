        "AsyncUpload": {
          "properties": {
            "input_url": {
              "description": "URL of the file to extract data from. Must be a PDF.",
              "type": "string" 

            },
            "job_id": {
              "description": "Job ID of the job sent to the endpoint.",
              "type": "string"
            },
            "webhook": {
              "type": "string",
              "pattern": " https?://(?:www\\\\.)?[a-zA-Z0-9./:]+",
              "description": "URL where status update JSONs can be sent. Must be open to POST requests that accept the header “content-type” with value “application/json”."
            },
            "metadata": {
              "type": "object: must contain the field splitting_method, whose values can take either one of “None”, “Document”, “Patient”.",
              "description": "Custom JSON to be included in the returned response, as well as identifying the splitting methodology used for the document splitting process. “None” does not split the document, “Document” splits the document provided by subdocuments separated by header pages and differing patients, and “Patient” only splits the document provided into subdocuments separated by differing patients."
            },
            "output_url": {
              "type": "string",
              "pattern": " (https?|s?ftp)://(?:www\\\\.)?[a-zA-Z0-9./:]+",
              "description": "URL where the resulting ZIP file can be sent. Must be open to PUT requests that accept the header “content-type” with value “application/zip”."
            }
          },
          "type": "object",
          "required": [
            "inputURL",
            "output_url",
            "webhook"
          ],
          "title": "AsyncUpload"
        },
